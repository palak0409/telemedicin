# REST API base URL. Keep "/api" to go through the Vite dev proxy,
# or use an absolute URL such as https://api.example.com/api.
VITE_API_BASE_URL=/api

# Backend the dev proxy forwards /api, /ws and /uploads to.
VITE_PROXY_TARGET=http://localhost:8000

# ISO 4217 currency code used to display consultation fees.
VITE_CURRENCY=USD
