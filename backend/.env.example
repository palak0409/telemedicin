# Copy to backend/.env (run.sh does this automatically and generates JWT_SECRET).

# --- Database --------------------------------------------------------------
# mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
# The database is created automatically if the user has CREATE privileges.
DATABASE_URL=mysql+pymysql://root:change-me@127.0.0.1:3306/telemedicine

# --- Auth ------------------------------------------------------------------
# At least 32 characters. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# --- HTTP ------------------------------------------------------------------
# Only needed when the frontend is not served through the Vite proxy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Scheduling ------------------------------------------------------------
# IANA timezone in which doctors enter their weekly availability.
CLINIC_TIMEZONE=UTC
BOOKING_HORIZON_DAYS=60
# How many minutes before the start (and after the end) a room can be joined.
CONSULTATION_JOIN_WINDOW_MINUTES=15

# --- WebRTC ICE servers ----------------------------------------------------
# Comma-separated URLs are allowed for both STUN_SERVER and TURN_SERVER.
STUN_SERVER=stun:stun.l.google.com:19302
# Example: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=
# "all" (default) or "relay" to force media through TURN (for testing TURN).
ICE_TRANSPORT_POLICY=all

# --- Seed data -------------------------------------------------------------
# The admin account is created on first start if it does not exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Platform Administrator
# Demo doctors/patient for local development. DEMO_PASSWORD is used for all of them.
SEED_DEMO_DATA=true
DEMO_PASSWORD=

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=2

# --- AI-assisted consultation documentation (optional) -----------------------
# Server-side only; never exposed to the browser. Leave GROQ_API_KEY empty to
# hide the recording feature (manual notes keep working).
# Speech-to-text: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
# Structured summary: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_RECORDING_MB=25
